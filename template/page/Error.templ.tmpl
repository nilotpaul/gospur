{{- if .UI.HasTailwind -}}
package web

import "{{ .ModPath }}/web/layouts"

templ Error(e string) {
	@layouts.Root("Error", "Some error happened") {
		<h1 class="text-4xl my-4 font-bold">
			{ e }
		</h1>
	}
}
{{- else -}}
package web

import "{{ .ModPath }}/web/layouts"

templ Error(e string) {
	@layouts.Root("Error", "Some error happened") {
		<h1>{ e }</h1>
	}
}
{{- end -}}