{{- if .Render.IsTemplates -}}
package main

import (
	"log"

	"{{ .ModPath }}/api"
	"{{ .ModPath }}/config"
)

func main() {
	// Loading the env vars from either a `.env` file or runtime.
	env := config.MustloadEnv()
	config.Env = env

	// API Server
	server := api.NewAPIServer(api.ServerConfig{
		ServeStatic:   ServeStatic,
		LoadTemplates: LoadTemplates,
	})

	log.Fatal(server.Start())
}
{{- else if (or .Render.IsSeperate .Render.IsTempl) -}}
package main

import (
	"log"

	"{{ .ModPath }}/api"
	"{{ .ModPath }}/config"
)

func main() {
	// Loading the env vars from either a `.env` file or runtime.
	env := config.MustloadEnv()
	config.Env = env

	// API Server
	server := api.NewAPIServer(api.ServerConfig{
		ServeStatic:   ServeStatic,
	})

	log.Fatal(server.Start())
}
{{- end -}}